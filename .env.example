# Judge API endpoint
JUDGE_API_BASE_URL=http://localhost:8000/api/v3
JUDGE_API_TIMEOUT_MS=8000
JUDGE_API_RETRY_COUNT=2
JUDGE_API_RETRY_DELAY_MS=300

# Required in production. Generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Base data directory (relative to repo root if not absolute)
DATA_DIR=var/thubai

# Optional overrides. Leave empty to use defaults from DATA_DIR.
# DB_PATH=var/thubai/thubai-history.sqlite
# SETTINGS_FILE=var/thubai/thubai-settings.json
# SUBMISSION_STORAGE_DIR=var/thubai/submissions
